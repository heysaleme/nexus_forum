{
  "name": "ChatRoom",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "community_id": {
      "type": "string",
      "description": "Null for DMs"
    },
    "type": {
      "type": "string",
      "enum": [
        "direct",
        "group"
      ],
      "default": "direct"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs"
    },
    "last_message": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "avatar_url": {
      "type": "string"
    },
    "unread_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "type",
    "participants"
  ]
}